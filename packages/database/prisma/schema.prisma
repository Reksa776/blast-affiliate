// AffiliateOS — Prisma baseline schema (Checkpoint 6C).
//
// Prisma 7.10.1 / MariaDB 11.8.6 / provider "mysql".
//
// Rules applied (docs/06-PRISMA-7-COMPATIBILITY-ADDENDUM.md §3.1):
//   - no `url` / `directUrl` / `shadowDatabaseUrl` in the datasource block;
//     the CLI reads them from prisma.config.ts, the runtime from the adapter.
//   - generator provider `prisma-client` with a mandatory `output`.
//
// NO MIGRATION HAS BEEN CREATED OR EXECUTED FOR THIS SCHEMA. It is validated only
// (`prisma validate` / `prisma generate`), never applied. The first migration needs
// explicit approval (docs/09-MIGRATION-PLAN.md).
//
// Design conventions (docs/07-DATABASE-BASELINE-DESIGN.md):
//   - ids: CHAR(36) UUIDv7 generated by the application (ADR-006). No database
//     default: the application owns id generation so ids are sortable and known
//     before insert.
//   - tenant columns: `tenant_id CHAR(36) NOT NULL` on every workspace-owned table,
//     with `@@unique([tenantId, id])` so the row can be a composite-FK target.
//   - child rows reference parents through `(tenant_id, x_id)`, which makes a
//     cross-workspace reference impossible at the database level, not just in code.
//   - time: DATETIME(3), always UTC; the driver session is forced to UTC
//     (`timezone: "Z"` in src/pool.ts) because the server runs `time_zone = SYSTEM`.
//   - money: DECIMAL(18,2) + CHAR(3) currency; commission rates as integer basis
//     points (never Float).
//   - status: Prisma enums -> MySQL native ENUM, not free-form strings.
//   - audited history (status history, notes, audit log) is append-only; actor
//     columns that must survive member deletion are plain references, not FKs.
//
// Deferred on purpose (documented in docs/07 §7): OrderAttribution (depends on an
// unverified API response shape), ScheduledTask (BullMQ owns repeatable schedules),
// a standalone ShopToken / ShopConnectionAudit table (tokens live on the connection
// row; audit goes to AuditLog), and a global Creator identity (creators are
// workspace-scoped so one workspace can never read another's creator data).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
}

/// Internal-only deployment in Phase 1; billing is out of scope.
enum WorkspacePlan {
  INTERNAL
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/// Workspace roles only. SUPER_ADMIN is NOT a workspace role: platform-wide access
/// is granted through PlatformAdminGrants so no tenant owner can mint a super user.
enum RoleKey {
  WORKSPACE_OWNER
  WORKSPACE_ADMIN
  AFFILIATE_MANAGER
  BUSINESS_DEVELOPMENT
  ANALYST
  VIEWER
}

enum OAuthIntent {
  CONNECT_SHOP
  RECONNECT_SHOP
  CONNECT_CREATOR
}

/// TikTok token `user_type`: 0 seller, 1 creator, 3 partner.
enum TikTokUserType {
  SELLER
  CREATOR
  PARTNER
}

enum ConnectionStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

enum ShopStatus {
  CONNECTED
  DISCONNECTED
  SUSPENDED
  DEAUTHORIZED
}

enum WebhookEventStatus {
  RECEIVED
  VERIFIED
  REJECTED
  PROCESSED
  FAILED
}

/// Creator pipeline stages plus the terminal states the CRM must represent.
enum CreatorStatus {
  NEW
  CONTACTED
  INVITED
  ACCEPTED
  COLLABORATING
  COMPLETED
  REJECTED
  UNRESPONSIVE
  BLACKLISTED
}

enum CreatorActivityType {
  NOTE
  CALL
  EMAIL
  WHATSAPP
  MEETING
  STATUS_CHANGE
  ASSIGNMENT
  OTHER
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum CampaignCreatorStatus {
  INVITED
  ACCEPTED
  DECLINED
  ACTIVE
  COMPLETED
  REMOVED
}

enum CampaignContentKind {
  BRIEF
  SCRIPT
  ASSET_LINK
}

enum SyncResource {
  SHOPS
  ORDERS
  ANALYTICS
  CREATORS
  CAMPAIGNS
  OUTREACH_QUOTA
}

enum SyncRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum SnapshotPeriod {
  DAY
  WEEK
  MONTH
}

/// Where a metric came from. Required so no dashboard can present derived or
/// manually imported numbers as live API facts.
enum MetricSource {
  TIKTOK_AFFILIATE_API
  MANUAL_IMPORT
  DERIVED
}

enum BackgroundJobStatus {
  PENDING
  SCHEDULED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  DEAD_LETTER
}

enum JobAttemptStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum AuditActorType {
  USER
  WORKER
  SYSTEM
  SUPER_ADMIN
}

enum NotificationLevel {
  INFO
  SUCCESS
  WARNING
  ERROR
}

// ---------------------------------------------------------------------------
// Identity — platform-global (never tenant-scoped)
// ---------------------------------------------------------------------------

/// One human, one credential set, membership in any number of workspaces.
model User {
  id               String     @id @db.Char(36)
  email            String     @unique @db.VarChar(320)
  emailVerifiedAt  DateTime?  @map("email_verified_at") @db.DateTime(3)
  /// Argon2id encoded string. Never selected by list queries.
  passwordHash     String     @map("password_hash") @db.VarChar(255)
  displayName      String     @map("display_name") @db.VarChar(120)
  status           UserStatus @default(ACTIVE)
  failedLoginCount Int        @default(0) @map("failed_login_count") @db.UnsignedInt
  lockedUntil      DateTime?  @map("locked_until") @db.DateTime(3)
  lastLoginAt      DateTime?  @map("last_login_at") @db.DateTime(3)
  createdAt        DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  sessions              Session[]
  memberships           WorkspaceMember[]
  oauthStates           OAuthState[]
  platformGrantsHeld    PlatformAdminGrant[]  @relation("PlatformGrantHolder")
  platformGrantsIssued  PlatformAdminGrant[]  @relation("PlatformGrantIssuer")
  notifications         Notification[]
  notificationReadState NotificationReadState[]

  @@index([status])
  @@map("users")
}

/// Opaque session token: the database stores only SHA-256(token).
model Session {
  id             String    @id @db.Char(36)
  userId         String    @map("user_id") @db.Char(36)
  tokenHash      Bytes     @unique @map("token_hash") @db.Binary(32)
  /// Last selected workspace. Re-validated against membership on every use.
  activeTenantId String?   @map("active_tenant_id") @db.Char(36)
  ipHash         Bytes?    @map("ip_hash") @db.Binary(32)
  userAgent      String?   @map("user_agent") @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.DateTime(3)
  expiresAt      DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt      DateTime? @map("revoked_at") @db.DateTime(3)

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeWorkspace Workspace? @relation(fields: [activeTenantId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Tenancy — workspace is the tenant boundary
// ---------------------------------------------------------------------------

/// The tenant aggregate. Named "workspace" in the product and API; `tenant_id`
/// remains the column name everywhere so the isolation rule stays greppable.
model Workspace {
  id        String          @id @db.Char(36)
  slug      String          @unique @db.VarChar(64)
  name      String          @db.VarChar(160)
  status    WorkspaceStatus @default(ACTIVE)
  plan      WorkspacePlan   @default(INTERNAL)
  createdAt DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  sessions                    Session[]
  members                     WorkspaceMember[]
  invitations                 WorkspaceInvitation[]
  roles                       Role[]
  rolePermissions             RolePermission[]
  memberRoles                 MemberRole[]
  oauthStates                 OAuthState[]
  shopConnections             ShopConnection[]
  shops                       Shop[]
  shopSyncStates              ShopSyncState[]
  webhookEvents               WebhookEvent[]
  creators                    Creator[]
  creatorProfiles             CreatorProfile[]
  creatorAssignments          CreatorAssignment[]
  creatorActivities           CreatorActivity[]
  creatorStatusHistories      CreatorStatusHistory[]
  creatorTags                 CreatorTag[]
  creatorTagAssignments       CreatorTagAssignment[]
  creatorNotes                CreatorNote[]
  creatorBlacklists           CreatorBlacklist[]
  campaigns                   Campaign[]
  campaignShops               CampaignShop[]
  campaignCreators            CampaignCreator[]
  campaignContents            CampaignContent[]
  campaignAdCodes             CampaignAdCode[]
  campaignStatusHistories     CampaignStatusHistory[]
  syncRuns                    SyncRun[]
  syncErrors                  SyncError[]
  creatorPerformanceSnapshots CreatorPerformanceSnapshot[]
  campaignPerformanceSnapshots CampaignPerformanceSnapshot[]
  shopPerformanceSnapshots    ShopPerformanceSnapshot[]
  backgroundJobs              BackgroundJob[]
  notifications               Notification[]
  notificationReadStates      NotificationReadState[]

  @@map("workspaces")
}

/// Tenant-scoped membership. The authoritative source for tenant resolution:
/// `(user_id, status)` is the index behind "which workspaces may this session use".
model WorkspaceMember {
  id                String       @id @db.Char(36)
  tenantId          String       @map("tenant_id") @db.Char(36)
  userId            String       @map("user_id") @db.Char(36)
  status            MemberStatus @default(INVITED)
  jobTitle          String?      @map("job_title") @db.VarChar(120)
  /// Audit reference only: no FK, so the record survives user deletion.
  invitedByMemberId String?      @map("invited_by_member_id") @db.Char(36)
  joinedAt          DateTime?    @map("joined_at") @db.DateTime(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  workspace          Workspace           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  roleAssignments    MemberRole[]
  creatorAssignments CreatorAssignment[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId, status])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id                String           @id @db.Char(36)
  tenantId          String           @map("tenant_id") @db.Char(36)
  email             String           @db.VarChar(320)
  roleKey           RoleKey          @map("role_key")
  /// SHA-256 of the invite token; the raw token only ever exists in the email.
  tokenHash         Bytes            @unique @map("token_hash") @db.Binary(32)
  status            InvitationStatus @default(PENDING)
  invitedByUserId   String?          @map("invited_by_user_id") @db.Char(36)
  expiresAt         DateTime         @map("expires_at") @db.DateTime(3)
  acceptedAt        DateTime?        @map("accepted_at") @db.DateTime(3)
  acceptedByUserId  String?          @map("accepted_by_user_id") @db.Char(36)
  createdAt         DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  workspace Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, email, status])
  @@index([expiresAt])
  @@map("workspace_invitations")
}

// ---------------------------------------------------------------------------
// RBAC — permissions are a global catalog, roles are per workspace
// ---------------------------------------------------------------------------

/// Global reference catalog (seeded in code + migration). Not tenant-scoped.
model Permission {
  id          String   @id @db.Char(36)
  key         String   @unique @db.VarChar(96)
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// Workspace-owned role. `is_system` roles cannot be renamed or deleted.
model Role {
  id        String   @id @db.Char(36)
  tenantId  String   @map("tenant_id") @db.Char(36)
  key       RoleKey
  name      String   @db.VarChar(120)
  isSystem  Boolean  @default(true) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  workspace       Workspace        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions     RolePermission[]
  memberRoles     MemberRole[]

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@map("roles")
}

/// Explicit grant of one permission to one workspace role.
model RolePermission {
  tenantId     String   @map("tenant_id") @db.Char(36)
  roleId       String   @map("role_id") @db.Char(36)
  permissionId String   @map("permission_id") @db.Char(36)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  workspace  Workspace  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([tenantId, roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Role assignment to a membership. A member may hold several roles.
model MemberRole {
  tenantId          String   @map("tenant_id") @db.Char(36)
  memberId          String   @map("member_id") @db.Char(36)
  roleId            String   @map("role_id") @db.Char(36)
  assignedByMemberId String? @map("assigned_by_member_id") @db.Char(36)
  assignedAt        DateTime @default(now()) @map("assigned_at") @db.DateTime(3)

  workspace Workspace       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member    WorkspaceMember @relation(fields: [tenantId, memberId], references: [tenantId, id], onDelete: Cascade)
  role      Role            @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, memberId, roleId])
  @@index([tenantId, roleId])
  @@map("member_roles")
}

/// Platform-wide access, separate from any workspace role and always audited.
/// This is the only path to cross-workspace operations besides the worker.
model PlatformAdminGrant {
  id              String    @id @db.Char(36)
  userId          String    @map("user_id") @db.Char(36)
  grantedByUserId String?   @map("granted_by_user_id") @db.Char(36)
  reason          String    @db.VarChar(255)
  grantedAt       DateTime  @default(now()) @map("granted_at") @db.DateTime(3)
  revokedAt       DateTime? @map("revoked_at") @db.DateTime(3)

  user      User  @relation("PlatformGrantHolder", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("PlatformGrantIssuer", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@map("platform_admin_grants")
}

// ---------------------------------------------------------------------------
// TikTok Shop connections (schema only — no live API in this phase)
// ---------------------------------------------------------------------------

/// Short-lived OAuth state, stored hashed and single-use.
model OAuthState {
  id           String      @id @db.Char(36)
  tenantId     String      @map("tenant_id") @db.Char(36)
  userId       String      @map("user_id") @db.Char(36)
  stateHash    Bytes       @unique @map("state_hash") @db.Binary(32)
  intent       OAuthIntent
  redirectPath String?     @map("redirect_path") @db.VarChar(255)
  consumedAt   DateTime?   @map("consumed_at") @db.DateTime(3)
  expiresAt    DateTime    @map("expires_at") @db.DateTime(3)
  createdAt    DateTime    @default(now()) @map("created_at") @db.DateTime(3)

  workspace Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("oauth_states")
}

/// Encrypted seller/creator authorization. Tokens are AES-256-GCM ciphertext with
/// a key version for rotation; no plaintext token column exists anywhere.
model ShopConnection {
  id                     String           @id @db.Char(36)
  tenantId               String           @map("tenant_id") @db.Char(36)
  userType               TikTokUserType   @map("user_type")
  openId                 String           @map("open_id") @db.VarChar(64)
  sellerName             String?          @map("seller_name") @db.VarChar(160)
  region                 String?          @db.Char(2)
  accessTokenCiphertext  Bytes            @map("access_token_ciphertext") @db.VarBinary(1024)
  refreshTokenCiphertext Bytes            @map("refresh_token_ciphertext") @db.VarBinary(1024)
  accessTokenExpiresAt   DateTime         @map("access_token_expires_at") @db.DateTime(3)
  refreshTokenExpiresAt  DateTime         @map("refresh_token_expires_at") @db.DateTime(3)
  grantedScopes          Json             @map("granted_scopes")
  /// Id of the encryption key that produced the ciphertext (rotation).
  keyVersion             Int              @map("key_version") @db.UnsignedSmallInt
  status                 ConnectionStatus @default(PENDING)
  lastRefreshedAt        DateTime?        @map("last_refreshed_at") @db.DateTime(3)
  lastErrorAt            DateTime?        @map("last_error_at") @db.DateTime(3)
  createdAt              DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  workspace Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shops     Shop[]

  @@unique([tenantId, openId, userType])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("shop_connections")
}

/// A TikTok shop authorized by a connection in the same workspace.
model Shop {
  id            String     @id @db.Char(36)
  tenantId      String     @map("tenant_id") @db.Char(36)
  connectionId  String     @map("connection_id") @db.Char(36)
  tiktokShopId  String     @map("tiktok_shop_id") @db.VarChar(64)
  /// Required query parameter on shop-scoped TikTok calls; not a secret key.
  shopCipher    String     @map("shop_cipher") @db.VarChar(128)
  name          String     @db.VarChar(200)
  region        String     @db.Char(2)
  shopType      String?    @map("shop_type") @db.VarChar(32)
  status        ShopStatus @default(CONNECTED)
  lastSyncedAt  DateTime?  @map("last_synced_at") @db.DateTime(3)
  createdAt     DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  workspace Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection ShopConnection @relation(fields: [tenantId, connectionId], references: [tenantId, id], onDelete: Restrict)

  campaigns        Campaign[]
  campaignShops    CampaignShop[]
  syncStates       ShopSyncState[]
  syncRuns         SyncRun[]
  creatorSnapshots CreatorPerformanceSnapshot[]
  campaignSnapshots CampaignPerformanceSnapshot[]
  shopSnapshots    ShopPerformanceSnapshot[]

  @@unique([tenantId, tiktokShopId])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("shops")
}

/// Per-resource sync cursor for one shop.
model ShopSyncState {
  id                 String       @id @db.Char(36)
  tenantId           String       @map("tenant_id") @db.Char(36)
  shopId             String       @map("shop_id") @db.Char(36)
  resource           SyncResource
  cursor             String?      @db.VarChar(255)
  lastSyncedAt       DateTime?    @map("last_synced_at") @db.DateTime(3)
  lastAttemptAt      DateTime?    @map("last_attempt_at") @db.DateTime(3)
  consecutiveFailures Int         @default(0) @map("consecutive_failures") @db.UnsignedInt
  createdAt          DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  workspace Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shop      Shop      @relation(fields: [tenantId, shopId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, shopId, resource])
  @@unique([tenantId, id])
  @@map("shop_sync_states")
}

/// Raw inbound webhook envelope. Deduplicated on TikTok's notification id; the
/// payload is stored for replay/audit, never trusted without signature checks.
model WebhookEvent {
  id                String             @id @db.Char(36)
  tenantId          String             @map("tenant_id") @db.Char(36)
  ttsNotificationId String             @map("tts_notification_id") @db.VarChar(96)
  topic             String             @db.VarChar(96)
  signatureVerified Boolean            @default(false) @map("signature_verified")
  status            WebhookEventStatus @default(RECEIVED)
  payload           Json
  receivedAt        DateTime           @default(now()) @map("received_at") @db.DateTime(3)
  processedAt       DateTime?          @map("processed_at") @db.DateTime(3)
  failureReason     String?            @map("failure_reason") @db.VarChar(255)

  workspace Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, ttsNotificationId])
  @@unique([tenantId, id])
  @@index([tenantId, receivedAt])
  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// Creator CRM
// ---------------------------------------------------------------------------

/// Workspace-scoped creator record. There is deliberately no platform-global
/// creator row: the same TikTok creator tracked by two workspaces produces two
/// independent rows, so neither can read the other's notes or pipeline.
model Creator {
  id              String        @id @db.Char(36)
  tenantId        String        @map("tenant_id") @db.Char(36)
  tiktokCreatorId String?       @map("tiktok_creator_id") @db.VarChar(64)
  username        String        @db.VarChar(96)
  displayName     String        @map("display_name") @db.VarChar(160)
  avatarUrl       String?       @map("avatar_url") @db.VarChar(512)
  followerCount   Int?          @map("follower_count") @db.UnsignedInt
  status          CreatorStatus @default(NEW)
  deletedAt       DateTime?     @map("deleted_at") @db.DateTime(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  workspace       Workspace             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile         CreatorProfile?
  assignments     CreatorAssignment[]
  activities      CreatorActivity[]
  statusHistory   CreatorStatusHistory[]
  tagAssignments  CreatorTagAssignment[]
  notes           CreatorNote[]
  blacklist       CreatorBlacklist?
  campaignLinks   CampaignCreator[]
  adCodes         CampaignAdCode[]
  snapshots       CreatorPerformanceSnapshot[]

  @@unique([tenantId, tiktokCreatorId])
  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, username])
  @@map("creators")
}

model CreatorProfile {
  id               String    @id @db.Char(36)
  tenantId         String    @map("tenant_id") @db.Char(36)
  creatorId        String    @map("creator_id") @db.Char(36)
  bio              String?   @db.Text
  region           String?   @db.Char(2)
  language         String?   @db.VarChar(16)
  /// Flexible upstream metrics snapshot; anything queried relationally gets its own column.
  metrics          Json?
  metricsCapturedAt DateTime? @map("metrics_captured_at") @db.DateTime(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  workspace Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator   Creator   @relation(fields: [tenantId, creatorId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, creatorId])
  @@unique([tenantId, id])
  @@map("creator_profiles")
}

/// BD ownership over time. History is kept: rows are closed, not deleted.
model CreatorAssignment {
  id                 String    @id @db.Char(36)
  tenantId           String    @map("tenant_id") @db.Char(36)
  creatorId          String    @map("creator_id") @db.Char(36)
  memberId           String    @map("member_id") @db.Char(36)
  isActive           Boolean   @default(true) @map("is_active")
  assignedAt         DateTime  @default(now()) @map("assigned_at") @db.DateTime(3)
  unassignedAt       DateTime? @map("unassigned_at") @db.DateTime(3)
  assignedByMemberId String?   @map("assigned_by_member_id") @db.Char(36)

  workspace Workspace       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator   Creator         @relation(fields: [tenantId, creatorId], references: [tenantId, id], onDelete: Cascade)
  member    WorkspaceMember @relation(fields: [tenantId, memberId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, memberId, isActive])
  @@index([tenantId, creatorId, isActive])
  @@map("creator_assignments")
}

/// Append-only interaction timeline (calls, messages, meetings).
model CreatorActivity {
  id            String              @id @db.Char(36)
  tenantId      String              @map("tenant_id") @db.Char(36)
  creatorId     String              @map("creator_id") @db.Char(36)
  type          CreatorActivityType
  occurredAt    DateTime            @default(now()) @map("occurred_at") @db.DateTime(3)
  summary       String              @db.VarChar(255)
  metadata      Json?
  actorMemberId String?             @map("actor_member_id") @db.Char(36)
  createdAt     DateTime            @default(now()) @map("created_at") @db.DateTime(3)

  workspace Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator   Creator   @relation(fields: [tenantId, creatorId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, creatorId, occurredAt])
  @@map("creator_activities")
}

/// Append-only pipeline transition log.
model CreatorStatusHistory {
  id                String         @id @db.Char(36)
  tenantId          String         @map("tenant_id") @db.Char(36)
  creatorId         String         @map("creator_id") @db.Char(36)
  fromStatus        CreatorStatus? @map("from_status")
  toStatus          CreatorStatus  @map("to_status")
  reason            String?        @db.VarChar(255)
  changedByMemberId String?        @map("changed_by_member_id") @db.Char(36)
  changedAt         DateTime       @default(now()) @map("changed_at") @db.DateTime(3)

  workspace Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator   Creator   @relation(fields: [tenantId, creatorId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, creatorId, changedAt])
  @@map("creator_status_histories")
}

model CreatorTag {
  id        String   @id @db.Char(36)
  tenantId  String   @map("tenant_id") @db.Char(36)
  label     String   @db.VarChar(64)
  color     String?  @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  workspace   Workspace             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments CreatorTagAssignment[]

  @@unique([tenantId, label])
  @@unique([tenantId, id])
  @@map("creator_tags")
}

model CreatorTagAssignment {
  tenantId   String   @map("tenant_id") @db.Char(36)
  creatorId  String   @map("creator_id") @db.Char(36)
  tagId      String   @map("tag_id") @db.Char(36)
  assignedAt DateTime @default(now()) @map("assigned_at") @db.DateTime(3)

  workspace Workspace  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator   Creator    @relation(fields: [tenantId, creatorId], references: [tenantId, id], onDelete: Cascade)
  tag       CreatorTag @relation(fields: [tenantId, tagId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, creatorId, tagId])
  @@index([tenantId, tagId])
  @@map("creator_tag_assignments")
}

model CreatorNote {
  id             String    @id @db.Char(36)
  tenantId       String    @map("tenant_id") @db.Char(36)
  creatorId      String    @map("creator_id") @db.Char(36)
  authorMemberId String?   @map("author_member_id") @db.Char(36)
  body           String    @db.Text
  deletedAt      DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  workspace Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator   Creator   @relation(fields: [tenantId, creatorId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, creatorId, createdAt])
  @@map("creator_notes")
}

/// Do-not-contact record; checked before any outreach or campaign invitation.
model CreatorBlacklist {
  id                String    @id @db.Char(36)
  tenantId          String    @map("tenant_id") @db.Char(36)
  creatorId         String    @map("creator_id") @db.Char(36)
  reason            String    @db.VarChar(255)
  scope             String?   @db.VarChar(64)
  createdByMemberId String?   @map("created_by_member_id") @db.Char(36)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  revokedAt         DateTime? @map("revoked_at") @db.DateTime(3)

  workspace Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator   Creator   @relation(fields: [tenantId, creatorId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, creatorId])
  @@unique([tenantId, id])
  @@map("creator_blacklists")
}

// ---------------------------------------------------------------------------
// Campaigns
// ---------------------------------------------------------------------------

model Campaign {
  id        String         @id @db.Char(36)
  tenantId  String         @map("tenant_id") @db.Char(36)
  shopId    String         @map("shop_id") @db.Char(36)
  name      String         @db.VarChar(160)
  status    CampaignStatus @default(DRAFT)
  startsAt  DateTime       @map("starts_at") @db.DateTime(3)
  endsAt    DateTime?      @map("ends_at") @db.DateTime(3)
  budget    Decimal?       @db.Decimal(18, 2)
  currency  String         @default("IDR") @db.Char(3)
  deletedAt DateTime?      @map("deleted_at") @db.DateTime(3)
  createdAt DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.DateTime(3)

  workspace     Workspace                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shop          Shop                        @relation(fields: [tenantId, shopId], references: [tenantId, id], onDelete: Restrict)
  shops         CampaignShop[]
  creators      CampaignCreator[]
  contents      CampaignContent[]
  adCodes       CampaignAdCode[]
  statusHistory CampaignStatusHistory[]
  snapshots     CampaignPerformanceSnapshot[]

  @@unique([tenantId, id])
  @@index([tenantId, status, startsAt])
  @@map("campaigns")
}

/// Additional shops a campaign targets. The primary shop is `Campaign.shopId`;
/// both references are composite, so neither can point outside the workspace.
model CampaignShop {
  id         String   @id @db.Char(36)
  tenantId   String   @map("tenant_id") @db.Char(36)
  campaignId String   @map("campaign_id") @db.Char(36)
  shopId     String   @map("shop_id") @db.Char(36)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  workspace Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign  Campaign  @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Cascade)
  shop      Shop      @relation(fields: [tenantId, shopId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, campaignId, shopId])
  @@unique([tenantId, id])
  @@map("campaign_shops")
}

model CampaignCreator {
  id          String                @id @db.Char(36)
  tenantId    String                @map("tenant_id") @db.Char(36)
  campaignId  String                @map("campaign_id") @db.Char(36)
  creatorId   String                @map("creator_id") @db.Char(36)
  status      CampaignCreatorStatus @default(INVITED)
  invitedAt   DateTime              @default(now()) @map("invited_at") @db.DateTime(3)
  respondedAt DateTime?             @map("responded_at") @db.DateTime(3)
  createdAt   DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.DateTime(3)

  workspace Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign  Campaign  @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Cascade)
  creator   Creator   @relation(fields: [tenantId, creatorId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, campaignId, creatorId])
  @@unique([tenantId, id])
  @@index([tenantId, creatorId, status])
  @@map("campaign_creators")
}

/// Versioned brief/script/asset-link content. Versions are append-only.
model CampaignContent {
  id                String              @id @db.Char(36)
  tenantId          String              @map("tenant_id") @db.Char(36)
  campaignId        String              @map("campaign_id") @db.Char(36)
  kind              CampaignContentKind @default(BRIEF)
  version           Int                 @db.UnsignedInt
  title             String              @db.VarChar(160)
  body              String              @db.Text
  createdByMemberId String?             @map("created_by_member_id") @db.Char(36)
  deletedAt         DateTime?           @map("deleted_at") @db.DateTime(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.DateTime(3)

  workspace Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign  Campaign  @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, campaignId, kind, version])
  @@unique([tenantId, id])
  @@map("campaign_contents")
}

model CampaignAdCode {
  id         String   @id @db.Char(36)
  tenantId   String   @map("tenant_id") @db.Char(36)
  campaignId String   @map("campaign_id") @db.Char(36)
  creatorId  String   @map("creator_id") @db.Char(36)
  code       String   @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  workspace Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign  Campaign  @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Cascade)
  creator   Creator   @relation(fields: [tenantId, creatorId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, campaignId, creatorId, code])
  @@unique([tenantId, id])
  @@map("campaign_ad_codes")
}

model CampaignStatusHistory {
  id                String          @id @db.Char(36)
  tenantId          String          @map("tenant_id") @db.Char(36)
  campaignId        String          @map("campaign_id") @db.Char(36)
  fromStatus        CampaignStatus? @map("from_status")
  toStatus          CampaignStatus  @map("to_status")
  reason            String?         @db.VarChar(255)
  changedByMemberId String?         @map("changed_by_member_id") @db.Char(36)
  changedAt         DateTime        @default(now()) @map("changed_at") @db.DateTime(3)

  workspace Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign  Campaign  @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, campaignId, changedAt])
  @@map("campaign_status_histories")
}

// ---------------------------------------------------------------------------
// Analytics — raw sync bookkeeping kept separate from aggregated snapshots
// ---------------------------------------------------------------------------

model SyncRun {
  id                   String        @id @db.Char(36)
  tenantId             String        @map("tenant_id") @db.Char(36)
  /// Nullable: workspace-wide runs (e.g. outreach quota) have no single shop.
  /// FK is single-column on purpose; workspace scoping is still enforced by tenant_id.
  shopId               String?       @map("shop_id") @db.Char(36)
  resource             SyncResource
  status               SyncRunStatus @default(RUNNING)
  startedAt            DateTime      @default(now()) @map("started_at") @db.DateTime(3)
  finishedAt           DateTime?     @map("finished_at") @db.DateTime(3)
  recordsProcessed     Int           @default(0) @map("records_processed") @db.UnsignedInt
  recordsFailed        Int           @default(0) @map("records_failed") @db.UnsignedInt
  cursor               String?       @db.VarChar(255)
  errorSummary         String?       @map("error_summary") @db.VarChar(255)
  triggeredByMemberId  String?       @map("triggered_by_member_id") @db.Char(36)

  workspace Workspace  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shop      Shop?      @relation(fields: [shopId], references: [id], onDelete: SetNull)
  errors    SyncError[]

  @@unique([tenantId, id])
  @@index([tenantId, resource, startedAt])
  @@index([shopId])
  @@map("sync_runs")
}

model SyncError {
  id         String   @id @db.Char(36)
  tenantId   String   @map("tenant_id") @db.Char(36)
  syncRunId  String   @map("sync_run_id") @db.Char(36)
  code       String?  @db.VarChar(64)
  message    String   @db.VarChar(255)
  retryable  Boolean  @default(false)
  context    Json?
  occurredAt DateTime @default(now()) @map("occurred_at") @db.DateTime(3)

  workspace Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  syncRun   SyncRun   @relation(fields: [syncRunId], references: [id], onDelete: Cascade)

  @@index([tenantId, syncRunId, occurredAt])
  @@map("sync_errors")
}

/// Aggregated creator performance for one shop and period. `source` and
/// `metricVersion` are mandatory so a dashboard cannot present unverified numbers
/// as live API facts (docs/03 capability matrix).
model CreatorPerformanceSnapshot {
  id            String         @id @db.Char(36)
  tenantId      String         @map("tenant_id") @db.Char(36)
  creatorId     String         @map("creator_id") @db.Char(36)
  shopId        String         @map("shop_id") @db.Char(36)
  period        SnapshotPeriod @default(DAY)
  periodStart   DateTime       @map("period_start") @db.DateTime(3)
  periodEnd     DateTime       @map("period_end") @db.DateTime(3)
  source        MetricSource
  metricVersion Int            @default(1) @map("metric_version") @db.UnsignedInt
  gmv           Decimal        @db.Decimal(18, 2)
  orders        Int            @default(0) @db.UnsignedInt
  commission    Decimal        @default(0) @db.Decimal(18, 2)
  itemsSold     Int            @default(0) @map("items_sold") @db.UnsignedInt
  capturedAt    DateTime       @default(now()) @map("captured_at") @db.DateTime(3)

  workspace Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator   Creator   @relation(fields: [tenantId, creatorId], references: [tenantId, id], onDelete: Cascade)
  shop      Shop      @relation(fields: [tenantId, shopId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, creatorId, shopId, periodStart, period])
  @@unique([tenantId, id])
  @@index([tenantId, shopId, periodStart])
  @@map("creator_performance_snapshots")
}

model CampaignPerformanceSnapshot {
  id               String         @id @db.Char(36)
  tenantId         String         @map("tenant_id") @db.Char(36)
  campaignId       String         @map("campaign_id") @db.Char(36)
  shopId           String         @map("shop_id") @db.Char(36)
  period           SnapshotPeriod @default(DAY)
  periodStart      DateTime       @map("period_start") @db.DateTime(3)
  periodEnd        DateTime       @map("period_end") @db.DateTime(3)
  source           MetricSource
  metricVersion    Int            @default(1) @map("metric_version") @db.UnsignedInt
  gmv              Decimal        @db.Decimal(18, 2)
  orders           Int            @default(0) @db.UnsignedInt
  commission       Decimal        @default(0) @db.Decimal(18, 2)
  creatorsEngaged  Int            @default(0) @map("creators_engaged") @db.UnsignedInt
  capturedAt       DateTime       @default(now()) @map("captured_at") @db.DateTime(3)

  workspace Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign  Campaign  @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Cascade)
  shop      Shop      @relation(fields: [tenantId, shopId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, campaignId, shopId, periodStart, period])
  @@unique([tenantId, id])
  @@index([tenantId, shopId, periodStart])
  @@map("campaign_performance_snapshots")
}

model ShopPerformanceSnapshot {
  id            String         @id @db.Char(36)
  tenantId      String         @map("tenant_id") @db.Char(36)
  shopId        String         @map("shop_id") @db.Char(36)
  period        SnapshotPeriod @default(DAY)
  periodStart   DateTime       @map("period_start") @db.DateTime(3)
  periodEnd     DateTime       @map("period_end") @db.DateTime(3)
  source        MetricSource
  metricVersion Int            @default(1) @map("metric_version") @db.UnsignedInt
  gmv           Decimal        @db.Decimal(18, 2)
  orders        Int            @default(0) @db.UnsignedInt
  commission    Decimal        @default(0) @db.Decimal(18, 2)
  refunds       Decimal        @default(0) @db.Decimal(18, 2)
  capturedAt    DateTime       @default(now()) @map("captured_at") @db.DateTime(3)

  workspace Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shop      Shop      @relation(fields: [tenantId, shopId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, shopId, periodStart, period])
  @@unique([tenantId, id])
  @@map("shop_performance_snapshots")
}

// ---------------------------------------------------------------------------
// Background jobs — identifiers only in payloads, never tokens
// ---------------------------------------------------------------------------

/// Durable job envelope. The tenant id is persisted here and re-validated by the
/// worker; the queue payload alone is never trusted.
model BackgroundJob {
  id               String              @id @db.Char(36)
  /// Nullable only for platform/system jobs (see SYSTEM_JOB_TYPES in tenancy.ts).
  tenantId         String?             @map("tenant_id") @db.Char(36)
  type             String              @db.VarChar(64)
  status           BackgroundJobStatus @default(PENDING)
  payload          Json
  /// Derived from (type, tenantId, natural key); globally unique so duplicate
  /// enqueues fail at the database, including for system jobs.
  idempotencyKey   String              @unique @map("idempotency_key") @db.VarChar(128)
  priority         Int                 @default(0) @db.SmallInt
  attempts         Int                 @default(0) @db.UnsignedSmallInt
  maxAttempts      Int                 @default(6) @map("max_attempts") @db.UnsignedSmallInt
  scheduledAt      DateTime            @default(now()) @map("scheduled_at") @db.DateTime(3)
  startedAt        DateTime?           @map("started_at") @db.DateTime(3)
  completedAt      DateTime?           @map("completed_at") @db.DateTime(3)
  lastErrorSummary String?             @map("last_error_summary") @db.VarChar(255)
  createdByUserId  String?             @map("created_by_user_id") @db.Char(36)
  createdAt        DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.DateTime(3)

  workspace   Workspace?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  jobAttempts BackgroundJobAttempt[]

  @@index([status, scheduledAt])
  @@index([tenantId, status])
  @@map("background_jobs")
}

model BackgroundJobAttempt {
  id            String           @id @db.Char(36)
  jobId         String           @map("job_id") @db.Char(36)
  attemptNumber Int              @map("attempt_number") @db.UnsignedSmallInt
  status        JobAttemptStatus @default(RUNNING)
  startedAt     DateTime         @default(now()) @map("started_at") @db.DateTime(3)
  finishedAt    DateTime?        @map("finished_at") @db.DateTime(3)
  durationMs    Int?             @map("duration_ms") @db.UnsignedInt
  errorClass    String?          @map("error_class") @db.VarChar(64)
  errorSummary  String?          @map("error_summary") @db.VarChar(255)

  job BackgroundJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, attemptNumber])
  @@map("background_job_attempts")
}

// ---------------------------------------------------------------------------
// Audit and notifications
// ---------------------------------------------------------------------------

/// Append-only audit trail. Deliberately has NO foreign keys: it must outlive the
/// rows and users it describes. Metadata is redacted by the writer; tokens,
/// passwords and secrets must never be stored here.
model AuditLog {
  id           String         @id @db.Char(36)
  /// Nullable for platform-level events that have no resolved workspace.
  tenantId     String?        @map("tenant_id") @db.Char(36)
  actorType    AuditActorType @map("actor_type")
  actorUserId  String?        @map("actor_user_id") @db.Char(36)
  actorMemberId String?       @map("actor_member_id") @db.Char(36)
  action       String         @db.VarChar(64)
  resourceType String         @map("resource_type") @db.VarChar(64)
  resourceId   String?        @map("resource_id") @db.Char(36)
  requestId    String?        @map("request_id") @db.VarChar(64)
  ipHash       Bytes?         @map("ip_hash") @db.Binary(32)
  userAgent    String?        @map("user_agent") @db.VarChar(255)
  metadata     Json?
  createdAt    DateTime       @default(now()) @map("created_at") @db.DateTime(3)

  @@index([tenantId, createdAt])
  @@index([tenantId, resourceType, resourceId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model Notification {
  id           String            @id @db.Char(36)
  tenantId     String            @map("tenant_id") @db.Char(36)
  userId       String            @map("user_id") @db.Char(36)
  type         String            @db.VarChar(64)
  title        String            @db.VarChar(160)
  body         String            @db.VarChar(1000)
  level        NotificationLevel @default(INFO)
  resourceType String?           @map("resource_type") @db.VarChar(64)
  resourceId   String?           @map("resource_id") @db.Char(36)
  createdAt    DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt    DateTime?         @map("expires_at") @db.DateTime(3)

  workspace  Workspace               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readStates NotificationReadState[]

  @@unique([tenantId, id])
  @@index([tenantId, userId, createdAt])
  @@map("notifications")
}

model NotificationReadState {
  tenantId       String   @map("tenant_id") @db.Char(36)
  notificationId String   @map("notification_id") @db.Char(36)
  userId         String   @map("user_id") @db.Char(36)
  readAt         DateTime @default(now()) @map("read_at") @db.DateTime(3)

  workspace    Workspace    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [tenantId, notificationId], references: [tenantId, id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tenantId, notificationId, userId])
  @@index([userId, readAt])
  @@map("notification_read_states")
}
