# ---------------------------------------------------------------------------
# AffiliateOS — environment variable names only. NO VALUES, EVER.
# Copy to `.env` (mode 600) and fill locally. `.env` is git-ignored.
# See docs/06-PRISMA-7-COMPATIBILITY-ADDENDUM.md §4.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Three credentials, three roles (docs/10-DATABASE-SECURITY-SEPARATION.md §3).
# Never reuse one across roles, and never let web/worker read the DDL account.
#   DATABASE_URL         runtime (web + worker)  — DML per table, no DDL.
#                        audit_logs is SELECT/INSERT only (append-only), and a
#                        table without a grant stays unreachable (fail-closed).
#   MIGRATE_DATABASE_URL Prisma CLI only        — DDL + DML on affiliateos.*,
#                        and the shadow-database credential on this host.
#   SHADOW_DATABASE_URL  `prisma migrate dev`   — affiliateos_shadow only.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Dev stack (native processes, no Docker — containers were dropped in P1.1):
#   npm run dev:stack    # web + worker together, labelled output (concurrently)
#   npm run dev:web      # Next.js only
#   npm run dev:worker   # worker only (tsc, then node dist/index.js)
# The worker resolves this file itself (apps/worker/src/index.ts), so no script
# needs `source .env` first. Redis is still absent; the worker does not use it
# until BullMQ lands in P1.3.
# ---------------------------------------------------------------------------

# Runtime connection for Prisma Client through @prisma/adapter-mariadb.
# Development uses the single account affiliateos_dev on the `affiliateos` schema.
# Format: mysql://<user>:<url-encoded-password>@127.0.0.1:3306/affiliateos
DATABASE_URL=

# Trust proxy headers for rate-limit keys (apps/web/src/lib/auth/client-ip.ts).
# false (default): x-forwarded-for / x-real-ip are ignored and every request is
#   bucketed as "unknown" — a global limit, not a spoofable one.
# true: only when the app really sits behind a proxy that overwrites those headers.
TRUST_PROXY=false

# Optional pool overrides (packages/database/src/pool.ts, docs/07 §3).
# Defaults: 5 connections per process, 1 warm idle connection.
DB_POOL_MAX=
DB_POOL_MIN_IDLE=

# Migration/DDL credential — Prisma CLI only, never the web or worker process.
# While empty, prisma.config.ts falls back to DATABASE_URL (transitional state).
# Format: mysql://<user>:<url-encoded-password>@127.0.0.1:3306/affiliateos
MIGRATE_DATABASE_URL=

# Shadow schema used by `prisma migrate dev` in development only.
# Must already exist: no account has CREATE DATABASE privilege.
# Format: mysql://<user>:<url-encoded-password>@127.0.0.1:3306/affiliateos_shadow
SHADOW_DATABASE_URL=

# Integration tests only (apps/web/src/lib/auth/test-env.ts). The suites refuse to
# run when this is missing or equal to DATABASE_URL, so a test run can never touch
# the development database. Reached with MIGRATE_DATABASE_URL in the test process
# (TD-7C-A8); the test process deletes MIGRATE_DATABASE_URL before opening a pool.
# Format: mysql://<user>:<url-encoded-password>@127.0.0.1:3306/affiliateos_test
TEST_DATABASE_URL=
